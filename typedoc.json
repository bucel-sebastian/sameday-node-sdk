{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "out": "docs/api",
  "name": "sameday-node-sdk",
  "readme": "README.md",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "validation": {
    "notExported": false
  },
  "externalSymbolLinkMappings": {
    "sameday-node-sdk": {
      "iteratePaginated": "#"
    }
  },
  "githubPages": false,
  "navigationLinks": {
    "GitHub": "https://github.com/bucel-sebastian/sameday-node-sdk"
  }
}
